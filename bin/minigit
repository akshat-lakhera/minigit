#!/bin/sh
# minigit entry script. Works from a checkout without installation.
# The lines up to the closing quotes run under /bin/sh and re-run this file
# with Python 3: "python3" on POSIX (many Linux systems have no "python"),
# "python" on Windows (Git Bash), where "python3" may be the Store stub.
''':'
if [ "$OS" != "Windows_NT" ] && command -v python3 >/dev/null 2>&1; then
    exec python3 "$0" "$@"
fi
exec python "$0" "$@"
'''
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from minigit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
